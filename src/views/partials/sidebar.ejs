<aside id="sidebar"
  class="fixed inset-y-0 left-0 z-50 flex h-screen w-64 -translate-x-full flex-col overflow-hidden border-r border-slate-800 bg-slate-900 text-slate-300 transition-all duration-300 lg:static lg:translate-x-0">

  <div class="flex min-h-[82px] items-center gap-3 border-b border-slate-800 px-4">

    <div
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 via-indigo-600 to-violet-600 text-lg font-extrabold text-white shadow-lg">
      E
    </div>

    <div id="sidebarTitle" class="min-w-0 flex-1">
      <h1 class="truncate text-sm font-bold text-white">
        Elementary Enrollment
      </h1>

      <p class="truncate text-xs text-slate-500">
        Management System
      </p>
    </div>

  </div>

  <nav class="flex-1 overflow-y-auto overflow-x-hidden px-3 py-5">

    <p id="menuTitle" class="px-3 pb-3 text-[10px] font-bold uppercase tracking-widest text-slate-500">
      Main Menu
    </p>


    <div class="space-y-1">

      <a href="/" title="Dashboard" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition
        <%= activePage === 'dashboard'
          ? 'bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-900/20'
          : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">

        <i data-lucide="layout-dashboard" class="h-5 w-5 shrink-0"></i>

        <span class="sidebar-text">
          Dashboard
        </span>

      </a>

      <a href="/admin/enrollment" title="Enrollment" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition
        <%= activePage === 'enrollment'
          ? 'bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-900/20'
          : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">

        <i data-lucide="clipboard-list" class="h-5 w-5 shrink-0"></i>

        <span class="sidebar-text flex-1">
          Enrollment
        </span>
        <span class="sidebar-badge rounded-full bg-amber-500/15 px-2 py-0.5 text-[10px] font-bold text-amber-400">
          12
        </span>

      </a>

      <a href="/admin/students" title="Students" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition
        <%= activePage === 'students'
          ? 'bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-900/20'
          : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">

        <i data-lucide="users" class="h-5 w-5 shrink-0"></i>

        <span class="sidebar-text">
          Students
        </span>

      </a>
      <a href="/admin/grades" title="Grades" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition
  <%= activePage === 'grades' 
    ? 'bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-900/20' 
    : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">

        <i data-lucide="book-open" class="h-5 w-5 shrink-0"></i>

        <span class="sidebar-text">
          Grades
        </span>

      </a>
      <a href="/admin/faculty" title="Faculty" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition
        <%= activePage === 'faculty'
          ? 'bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-900/20'
          : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">

        <i data-lucide="graduation-cap" class="h-5 w-5 shrink-0"></i>

        <span class="sidebar-text">
          Faculty
        </span>

      </a>

      <a href="/admin/academic-year" title="Academic Year" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition
        <%= activePage === 'academic-year'
          ? 'bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-900/20'
          : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">

        <i data-lucide="calendar-days" class="h-5 w-5 shrink-0"></i>

        <span class="sidebar-text">
          Academic Year
        </span>

      </a>

      <a href="/admin/sections" title="Sections" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition
        <%= activePage === 'sections'
          ? 'bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-900/20'
          : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">

        <i data-lucide="layers" class="h-5 w-5 shrink-0"></i>

        <span class="sidebar-text">
          Sections
        </span>

      </a>

      <a href="/admin/reports" title="Reports" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition
        <%= activePage === 'reports'
          ? 'bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-900/20'
          : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">

        <i data-lucide="file-bar-chart" class="h-5 w-5 shrink-0"></i>

        <span class="sidebar-text">
          Reports
        </span>

      </a>

      <a href="/admin/settings" title="Settings" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition
        <%= activePage === 'settings'
          ? 'bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-900/20'
          : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">

        <i data-lucide="settings" class="h-5 w-5 shrink-0"></i>

        <span class="sidebar-text">
          Settings
        </span>

      </a>

      <a
     href="/admin/chat"
     title="Chat"
      class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition
      <%= activePage === 'chat'
      ? 'bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-900/20'
      : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>"
      >
    <i data-lucide="message-circle" class="h-5 w-5 shrink-0"></i>
    <span class="sidebar-text">Chat</span>
</a>

    </div>

  </nav>

  <div class="border-t border-slate-800 p-4">

    <div id="profileSection" class="mb-3 flex items-center gap-3">

      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-600 font-bold text-white">
        A
      </div>

      <div class="sidebar-text min-w-0 flex-1">

        <p class="truncate text-sm font-semibold text-white">
          Administrator
        </p>

        <p class="truncate text-[10px] text-slate-500">
          System Admin
        </p>

      </div>

      <button type="button"
        class="sidebar-text rounded-lg p-1.5 text-slate-500 transition hover:bg-slate-800 hover:text-white"
        title="More Options">

        <i data-lucide="more-vertical" class="h-5 w-5"></i>

      </button>

    </div>

    <button id="logoutBtn" type="button" title="Logout"
      class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-red-400 transition hover:bg-red-500/10 hover:text-red-300">

      <i data-lucide="log-out" class="h-5 w-5 shrink-0"></i>

      <span class="sidebar-text">
        Logout
      </span>

    </button>

  </div>

</aside>

<div id="sidebarOverlay" class="fixed inset-0 z-40 hidden bg-slate-950/50 backdrop-blur-sm lg:hidden"></div>
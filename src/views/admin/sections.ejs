<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sections - Elementary Enrollment Management System</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <style>
    html,
    body {
      font-family: "DM Sans", sans-serif;
      height: 100%;
    }

    body {
      overflow: hidden;
    }

    ::-webkit-scrollbar {
      display: none;
    }
  </style>
</head>

<body class="h-screen bg-slate-50 text-slate-900">

  <div class="flex h-screen w-full overflow-hidden">

    <!-- Sidebar -->
    <%- include('../partials/sidebar', { activePage: 'sections' }) %>

    <!-- Main Content -->
    <div class="flex min-w-0 flex-1 flex-col">

      <!-- Navbar -->
      <%- include('../partials/navbar', { pageTitle: 'Sections' }) %>

      <!-- Page -->
      <main class="flex-1 overflow-y-auto p-6 lg:p-8">

        <!-- Header -->
        <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">

          <div>
            <h1 class="text-2xl font-bold text-slate-900">
              Sections
            </h1>

            <p class="mt-1 text-sm text-slate-500">
              Manage grade levels, sections, advisers, and class capacity.
            </p>
          </div>

          <button
            onclick="addSection()"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-700"
          >
            <i data-lucide="plus" class="h-5 w-5"></i>
            Add Section
          </button>

        </div>

        <!-- Stats -->
        <div class="mb-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">

          <!-- Total -->
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">

              <div>
                <p class="text-sm font-medium text-slate-500">
                  Total Sections
                </p>

                <h2 class="mt-2 text-3xl font-bold text-slate-900">
                  18
                </h2>
              </div>

              <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                <i data-lucide="layers" class="h-6 w-6"></i>
              </div>

            </div>
          </div>

          <!-- Active -->
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">

              <div>
                <p class="text-sm font-medium text-slate-500">
                  Active Sections
                </p>

                <h2 class="mt-2 text-3xl font-bold text-slate-900">
                  16
                </h2>
              </div>

              <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                <i data-lucide="check-circle" class="h-6 w-6"></i>
              </div>

            </div>
          </div>

          <!-- Students -->
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">

              <div>
                <p class="text-sm font-medium text-slate-500">
                  Enrolled Students
                </p>

                <h2 class="mt-2 text-3xl font-bold text-slate-900">
                  248
                </h2>
              </div>

              <div class="rounded-xl bg-amber-50 p-3 text-amber-600">
                <i data-lucide="users" class="h-6 w-6"></i>
              </div>

            </div>
          </div>

          <!-- Available Slots -->
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">

              <div>
                <p class="text-sm font-medium text-slate-500">
                  Available Slots
                </p>

                <h2 class="mt-2 text-3xl font-bold text-slate-900">
                  112
                </h2>
              </div>

              <div class="rounded-xl bg-sky-50 p-3 text-sky-600">
                <i data-lucide="user-plus" class="h-6 w-6"></i>
              </div>

            </div>
          </div>

        </div>

        <!-- Table Card -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

          <!-- Filters -->
          <div class="border-b border-slate-200 p-5">

            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

              <!-- Search -->
              <div class="relative w-full lg:max-w-md">

                <i
                  data-lucide="search"
                  class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
                ></i>

                <input
                  id="searchInput"
                  type="text"
                  placeholder="Search section or adviser..."
                  onkeyup="filterSections()"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                >

              </div>

              <!-- Filters -->
              <div class="flex flex-col gap-3 sm:flex-row">

                <select
                  id="gradeFilter"
                  onchange="filterSections()"
                  class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600 outline-none focus:border-indigo-500"
                >
                  <option value="">All Grade Levels</option>
                  <option value="Kindergarten">Kindergarten</option>
                  <option value="Grade 1">Grade 1</option>
                  <option value="Grade 2">Grade 2</option>
                  <option value="Grade 3">Grade 3</option>
                  <option value="Grade 4">Grade 4</option>
                  <option value="Grade 5">Grade 5</option>
                  <option value="Grade 6">Grade 6</option>
                </select>

                <select
                  id="statusFilter"
                  onchange="filterSections()"
                  class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600 outline-none focus:border-indigo-500"
                >
                  <option value="">All Status</option>
                  <option value="Active">Active</option>
                  <option value="Inactive">Inactive</option>
                </select>

                <button
                  onclick="exportSections()"
                  class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-600 transition hover:bg-slate-50"
                >
                  <i data-lucide="download" class="h-4 w-4"></i>
                  Export
                </button>

              </div>

            </div>

          </div>

          <!-- Table -->
          <div class="overflow-x-auto">

            <table class="w-full text-left text-sm">

              <thead class="bg-slate-50 text-xs uppercase text-slate-500">

                <tr>
                  <th class="px-6 py-4 font-semibold">Section</th>
                  <th class="px-6 py-4 font-semibold">Grade Level</th>
                  <th class="px-6 py-4 font-semibold">Adviser</th>
                  <th class="px-6 py-4 font-semibold">Students</th>
                  <th class="px-6 py-4 font-semibold">Capacity</th>
                  <th class="px-6 py-4 font-semibold">Status</th>
                  <th class="px-6 py-4 text-right font-semibold">Action</th>
                </tr>

              </thead>

              <tbody id="sectionTable" class="divide-y divide-slate-100">

                <!-- Section 1 -->
                <tr
                  class="section-row transition hover:bg-slate-50"
                  data-grade="Grade 1"
                  data-status="Active"
                >

                  <td class="px-6 py-5">
                    <p class="font-semibold text-slate-900">
                      Mabini
                    </p>

                    <p class="text-xs text-slate-500">
                      SY 2026–2027
                    </p>
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    Grade 1
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    Juan Dela Cruz
                  </td>

                  <td class="px-6 py-5">
                    <span class="font-semibold text-slate-700">
                      28
                    </span>
                    <span class="text-slate-400">
                      / 40
                    </span>
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    12 slots
                  </td>

                  <td class="px-6 py-5">
                    <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-600">
                      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                      Active
                    </span>
                  </td>

                  <td class="px-6 py-5 text-right">

                    <button
                      onclick="viewSection('Mabini')"
                      class="rounded-lg p-2 text-slate-500 transition hover:bg-indigo-50 hover:text-indigo-600"
                    >
                      <i data-lucide="eye" class="h-5 w-5"></i>
                    </button>

                    <button
                      onclick="editSection('Mabini')"
                      class="rounded-lg p-2 text-slate-500 transition hover:bg-indigo-50 hover:text-indigo-600"
                    >
                      <i data-lucide="pencil" class="h-5 w-5"></i>
                    </button>

                  </td>

                </tr>

                <!-- Section 2 -->
                <tr
                  class="section-row transition hover:bg-slate-50"
                  data-grade="Grade 2"
                  data-status="Active"
                >

                  <td class="px-6 py-5">
                    <p class="font-semibold text-slate-900">
                      Rizal
                    </p>

                    <p class="text-xs text-slate-500">
                      SY 2026–2027
                    </p>
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    Grade 2
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    Ana Santos
                  </td>

                  <td class="px-6 py-5">
                    <span class="font-semibold text-slate-700">
                      35
                    </span>
                    <span class="text-slate-400">
                      / 40
                    </span>
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    5 slots
                  </td>

                  <td class="px-6 py-5">
                    <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-600">
                      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                      Active
                    </span>
                  </td>

                  <td class="px-6 py-5 text-right">

                    <button
                      onclick="viewSection('Rizal')"
                      class="rounded-lg p-2 text-slate-500 transition hover:bg-indigo-50 hover:text-indigo-600"
                    >
                      <i data-lucide="eye" class="h-5 w-5"></i>
                    </button>

                    <button
                      onclick="editSection('Rizal')"
                      class="rounded-lg p-2 text-slate-500 transition hover:bg-indigo-50 hover:text-indigo-600"
                    >
                      <i data-lucide="pencil" class="h-5 w-5"></i>
                    </button>

                  </td>

                </tr>

                <!-- Section 3 -->
                <tr
                  class="section-row transition hover:bg-slate-50"
                  data-grade="Grade 3"
                  data-status="Active"
                >

                  <td class="px-6 py-5">
                    <p class="font-semibold text-slate-900">
                      Bonifacio
                    </p>

                    <p class="text-xs text-slate-500">
                      SY 2026–2027
                    </p>
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    Grade 3
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    Mark Reyes
                  </td>

                  <td class="px-6 py-5">
                    <span class="font-semibold text-slate-700">
                      31
                    </span>
                    <span class="text-slate-400">
                      / 40
                    </span>
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    9 slots
                  </td>

                  <td class="px-6 py-5">
                    <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-600">
                      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                      Active
                    </span>
                  </td>

                  <td class="px-6 py-5 text-right">

                    <button
                      onclick="viewSection('Bonifacio')"
                      class="rounded-lg p-2 text-slate-500 transition hover:bg-indigo-50 hover:text-indigo-600"
                    >
                      <i data-lucide="eye" class="h-5 w-5"></i>
                    </button>

                    <button
                      onclick="editSection('Bonifacio')"
                      class="rounded-lg p-2 text-slate-500 transition hover:bg-indigo-50 hover:text-indigo-600"
                    >
                      <i data-lucide="pencil" class="h-5 w-5"></i>
                    </button>

                  </td>

                </tr>

                <!-- Section 4 -->
                <tr
                  class="section-row transition hover:bg-slate-50"
                  data-grade="Grade 4"
                  data-status="Inactive"
                >

                  <td class="px-6 py-5">
                    <p class="font-semibold text-slate-900">
                      Bonifacio
                    </p>

                    <p class="text-xs text-slate-500">
                      SY 2025–2026
                    </p>
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    Grade 4
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    Lisa Mendoza
                  </td>

                  <td class="px-6 py-5">
                    <span class="font-semibold text-slate-700">
                      38
                    </span>
                    <span class="text-slate-400">
                      / 40
                    </span>
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    2 slots
                  </td>

                  <td class="px-6 py-5">
                    <span class="inline-flex items-center gap-2 rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-600">
                      <span class="h-2 w-2 rounded-full bg-rose-500"></span>
                      Inactive
                    </span>
                  </td>

                  <td class="px-6 py-5 text-right">

                    <button
                      onclick="viewSection('Bonifacio - Grade 4')"
                      class="rounded-lg p-2 text-slate-500 transition hover:bg-indigo-50 hover:text-indigo-600"
                    >
                      <i data-lucide="eye" class="h-5 w-5"></i>
                    </button>

                  </td>

                </tr>

                <!-- Section 5 -->
                <tr
                  class="section-row transition hover:bg-slate-50"
                  data-grade="Kindergarten"
                  data-status="Active"
                >

                  <td class="px-6 py-5">
                    <p class="font-semibold text-slate-900">
                      Sampaguita
                    </p>

                    <p class="text-xs text-slate-500">
                      SY 2026–2027
                    </p>
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    Kindergarten
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    James Santos
                  </td>

                  <td class="px-6 py-5">
                    <span class="font-semibold text-slate-700">
                      24
                    </span>
                    <span class="text-slate-400">
                      / 30
                    </span>
                  </td>

                  <td class="px-6 py-5 text-slate-600">
                    6 slots
                  </td>

                  <td class="px-6 py-5">
                    <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-600">
                      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                      Active
                    </span>
                  </td>

                  <td class="px-6 py-5 text-right">

                    <button
                      onclick="viewSection('Sampaguita')"
                      class="rounded-lg p-2 text-slate-500 transition hover:bg-indigo-50 hover:text-indigo-600"
                    >
                      <i data-lucide="eye" class="h-5 w-5"></i>
                    </button>

                    <button
                      onclick="editSection('Sampaguita')"
                      class="rounded-lg p-2 text-slate-500 transition hover:bg-indigo-50 hover:text-indigo-600"
                    >
                      <i data-lucide="pencil" class="h-5 w-5"></i>
                    </button>

                  </td>

                </tr>

              </tbody>

            </table>

          </div>

          <!-- Pagination -->
          <div class="flex flex-col gap-3 border-t border-slate-200 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">

            <p class="text-sm text-slate-500">
              Showing
              <span class="font-semibold text-slate-700">1–5</span>
              of
              <span class="font-semibold text-slate-700">18</span>
              sections
            </p>

            <div class="flex items-center gap-2">

              <button
                class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-400"
                disabled
              >
                Previous
              </button>

              <button
                class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white"
              >
                1
              </button>

              <button
                class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50"
              >
                2
              </button>

              <button
                class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50"
              >
                3
              </button>

              <button
                class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50"
              >
                Next
              </button>

            </div>

          </div>

        </div>

        <!-- Footer -->
        <div class="py-6 text-center text-xs text-slate-400">
          © 2026 Elementary Enrollment Management System. All rights reserved.
        </div>

      </main>

    </div>

  </div>

<script src="/js/section.js" defer></script>
  <script>
    lucide.createIcons();

    function filterSections() {

      const search = document
        .getElementById("searchInput")
        .value
        .toLowerCase();

      const grade = document
        .getElementById("gradeFilter")
        .value;

      const status = document
        .getElementById("statusFilter")
        .value;

      const rows = document.querySelectorAll(".section-row");

      rows.forEach(row => {

        const text = row.innerText.toLowerCase();
        const rowGrade = row.dataset.grade;
        const rowStatus = row.dataset.status;

        const matchesSearch = text.includes(search);
        const matchesGrade = !grade || rowGrade === grade;
        const matchesStatus = !status || rowStatus === status;

        row.style.display =
          matchesSearch &&
          matchesGrade &&
          matchesStatus
            ? ""
            : "none";

      });
    }

    function addSection() {
      alert("Add Section form will open here.");
    }

    function viewSection(section) {
      alert("Viewing section: " + section);
    }

    function editSection(section) {
      alert("Editing section: " + section);
    }

    function exportSections() {
      alert("Section records will be exported.");
    }
  </script>

</body>
</html>
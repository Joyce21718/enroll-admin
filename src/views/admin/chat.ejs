<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { pageTitle: 'Chat' }) %>
</head>

<body class="h-screen overflow-hidden bg-slate-100 text-slate-900 antialiased">
    <div class="flex h-screen w-full overflow-hidden">
        <%- include('../partials/sidebar', { activePage: 'chat' }) %>

        <main class="flex min-w-0 flex-1 flex-col overflow-hidden">
            <%- include('../partials/navbar', { pageTitle: 'Chat' }) %>

            <div class="flex min-h-0 flex-1 flex-col p-3 sm:p-5 lg:p-6">
                <div
                    id="chatLayout"
                    class="mx-auto flex min-h-0 w-full max-w-[1550px] flex-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
                >
                    <aside
                        id="conversationPanel"
                        class="flex min-h-0 w-full flex-col border-r border-slate-200 bg-white lg:w-[330px] lg:shrink-0"
                    >
                        <div class="border-b border-slate-100 px-5 pb-4 pt-5">
                            <div class="mb-5 flex items-center justify-between">
                                <div>
                                    <h1 class="text-2xl font-bold tracking-tight text-slate-900">
                                        Chats
                                    </h1>
                                    <p class="mt-1 text-xs text-slate-400">
                                        Connect with faculty members
                                    </p>
                                </div>

                                <button
                                    type="button"
                                    class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition hover:bg-blue-100 hover:text-blue-600"
                                    title="New message"
                                >
                                    <i data-lucide="square-pen" class="h-4 w-4"></i>
                                </button>
                            </div>

                            <div class="relative">
                                <i
                                    data-lucide="search"
                                    class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                                ></i>

                                <input
                                    id="chatSearch"
                                    type="search"
                                    placeholder="Search Messenger..."
                                    class="h-11 w-full rounded-xl border-0 bg-slate-100 pl-11 pr-4 text-sm text-slate-700 outline-none ring-0 placeholder:text-slate-400 focus:bg-slate-50 focus:ring-2 focus:ring-blue-100"
                                />
                            </div>
                        </div>

                        <div class="flex items-center justify-between px-5 py-3">
                            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">
                                Recent chats
                            </h2>

                            <span
                                id="conversationCount"
                                class="rounded-full bg-blue-50 px-2 py-1 text-[10px] font-bold text-blue-600"
                            >
                                4
                            </span>
                        </div>

                        <div
                            id="conversationList"
                            class="min-h-0 flex-1 space-y-1 overflow-y-auto px-3 pb-4"
                        >
                            <button
                                type="button"
                                class="conversation-item group flex w-full items-center gap-3 rounded-xl bg-blue-600 px-3 py-3 text-left transition"
                                data-teacher-id="teacher-1"
                            >
                                <div class="relative shrink-0">
                                    <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-blue-100 text-sm font-bold text-blue-700">
                                        JD
                                    </div>

                                    <span class="absolute bottom-0 right-0 h-3.5 w-3.5 rounded-full border-2 border-white bg-emerald-500"></span>
                                </div>

                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="conversation-name truncate text-sm font-bold text-white">
                                            Juan Dela Cruz
                                        </p>

                                        <span class="conversation-time shrink-0 text-[10px] text-blue-100">
                                            10:42 AM
                                        </span>
                                    </div>

                                    <div class="mt-1 flex items-center justify-between gap-2">
                                        <p class="conversation-preview truncate text-xs text-blue-100">
                                            Thank you for the update.
                                        </p>

                                        <span class="conversation-unread hidden h-5 min-w-5 items-center justify-center rounded-full bg-white px-1.5 text-[10px] font-bold text-blue-600">
                                            2
                                        </span>
                                    </div>
                                </div>
                            </button>

                            <button
                                type="button"
                                class="conversation-item group flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left transition hover:bg-slate-100"
                                data-teacher-id="teacher-2"
                            >
                                <div class="relative shrink-0">
                                    <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-pink-100 text-sm font-bold text-pink-700">
                                        MS
                                    </div>

                                    <span class="absolute bottom-0 right-0 h-3.5 w-3.5 rounded-full border-2 border-white bg-emerald-500"></span>
                                </div>

                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="conversation-name truncate text-sm font-bold text-slate-800">
                                            Maria Santos
                                        </p>

                                        <span class="conversation-time shrink-0 text-[10px] text-slate-400">
                                            9:30 AM
                                        </span>
                                    </div>

                                    <div class="mt-1 flex items-center justify-between gap-2">
                                        <p class="conversation-preview truncate text-xs text-slate-400">
                                            Can you send the report?
                                        </p>

                                        <span class="conversation-unread hidden h-5 min-w-5 items-center justify-center rounded-full bg-blue-600 px-1.5 text-[10px] font-bold text-white">
                                            1
                                        </span>
                                    </div>
                                </div>
                            </button>

                            <button
                                type="button"
                                class="conversation-item group flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left transition hover:bg-slate-100"
                                data-teacher-id="teacher-3"
                            >
                                <div class="relative shrink-0">
                                    <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-amber-100 text-sm font-bold text-amber-700">
                                        MR
                                    </div>

                                    <span class="absolute bottom-0 right-0 h-3.5 w-3.5 rounded-full border-2 border-white bg-slate-300"></span>
                                </div>

                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="conversation-name truncate text-sm font-bold text-slate-800">
                                            Mark Reyes
                                        </p>

                                        <span class="conversation-time shrink-0 text-[10px] text-slate-400">
                                            Yesterday
                                        </span>
                                    </div>

                                    <div class="mt-1 flex items-center justify-between gap-2">
                                        <p class="conversation-preview truncate text-xs text-slate-400">
                                            See you tomorrow.
                                        </p>

                                        <span class="conversation-unread hidden h-5 min-w-5 items-center justify-center rounded-full bg-blue-600 px-1.5 text-[10px] font-bold text-white">
                                            3
                                        </span>
                                    </div>
                                </div>
                            </button>

                            <button
                                type="button"
                                class="conversation-item group flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left transition hover:bg-slate-100"
                                data-teacher-id="teacher-4"
                            >
                                <div class="relative shrink-0">
                                    <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-full bg-violet-100 text-sm font-bold text-violet-700">
                                        AM
                                    </div>

                                    <span class="absolute bottom-0 right-0 h-3.5 w-3.5 rounded-full border-2 border-white bg-emerald-500"></span>
                                </div>

                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="conversation-name truncate text-sm font-bold text-slate-800">
                                            Ana Mendoza
                                        </p>

                                        <span class="conversation-time shrink-0 text-[10px] text-slate-400">
                                            Monday
                                        </span>
                                    </div>

                                    <div class="mt-1 flex items-center justify-between gap-2">
                                        <p class="conversation-preview truncate text-xs text-slate-400">
                                            The meeting is confirmed.
                                        </p>

                                        <span class="conversation-unread hidden h-5 min-w-5 items-center justify-center rounded-full bg-blue-600 px-1.5 text-[10px] font-bold text-white">
                                            1
                                        </span>
                                    </div>
                                </div>
                            </button>
                        </div>
                    </aside>

                    <section
                        id="chatPanel"
                        class="hidden min-h-0 min-w-0 flex-1 flex-col bg-white lg:flex"
                    >
                        <header class="flex h-[78px] shrink-0 items-center justify-between border-b border-slate-200 px-4 sm:px-6">
                            <div class="flex min-w-0 items-center gap-3">
                                <button
                                    id="mobileChatBackBtn"
                                    type="button"
                                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 lg:hidden"
                                    title="Back to chats"
                                >
                                    <i data-lucide="arrow-left" class="h-5 w-5"></i>
                                </button>

                                <div class="relative shrink-0">
                                    <div
                                        id="teacherAvatar"
                                        class="flex h-11 w-11 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700"
                                    >
                                        JD
                                    </div>

                                    <span
                                        id="teacherOnlineDot"
                                        class="absolute bottom-0 right-0 h-3.5 w-3.5 rounded-full border-2 border-white bg-emerald-500"
                                    ></span>
                                </div>

                                <div class="min-w-0">
                                    <h2
                                        id="chatUserName"
                                        class="truncate text-sm font-bold text-slate-900 sm:text-base"
                                    >
                                        Juan Dela Cruz
                                    </h2>

                                    <p
                                        id="chatUserRole"
                                        class="truncate text-xs text-slate-400"
                                    >
                                        Faculty Member
                                    </p>

                                    <p
                                        id="chatUserStatus"
                                        class="text-[10px] font-medium text-emerald-500"
                                    >
                                        Active now
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center gap-1 sm:gap-2">
                                <button
                                    type="button"
                                    class="hidden h-9 w-9 items-center justify-center rounded-full text-blue-600 transition hover:bg-blue-50 sm:flex"
                                    title="Voice call"
                                >
                                    <i data-lucide="phone" class="h-4 w-4"></i>
                                </button>

                                <button
                                    type="button"
                                    class="hidden h-9 w-9 items-center justify-center rounded-full text-blue-600 transition hover:bg-blue-50 sm:flex"
                                    title="Video call"
                                >
                                    <i data-lucide="video" class="h-4 w-4"></i>
                                </button>

                                <button
                                    id="chatInfoBtn"
                                    type="button"
                                    class="flex h-9 w-9 items-center justify-center rounded-full text-blue-600 transition hover:bg-blue-50"
                                    title="Conversation information"
                                >
                                    <i data-lucide="info" class="h-5 w-5"></i>
                                </button>

                                <button
                                    type="button"
                                    class="hidden h-9 w-9 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 sm:flex"
                                    title="More options"
                                >
                                    <i data-lucide="more-horizontal" class="h-5 w-5"></i>
                                </button>
                            </div>
                        </header>

                        <div
                            id="messageContainer"
                            class="min-h-0 flex-1 overflow-y-auto bg-[radial-gradient(circle_at_top,_#f8fbff,_#ffffff_45%)] px-4 py-6 sm:px-8"
                        ></div>

                        <div class="shrink-0 border-t border-slate-100 bg-white px-3 py-3 sm:px-6 sm:py-4">
                            <form
                                id="messageForm"
                                class="flex items-end gap-2"
                            >
                                <button
                                    type="button"
                                    class="hidden h-11 w-11 shrink-0 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 sm:flex"
                                    title="Attach file"
                                >
                                    <i data-lucide="paperclip" class="h-5 w-5"></i>
                                </button>

                                <div class="flex min-w-0 flex-1 items-end rounded-2xl bg-slate-100 px-4 py-2">
                                    <textarea
                                        id="messageInput"
                                        rows="1"
                                        placeholder="Aa"
                                        class="max-h-28 min-h-[28px] flex-1 resize-none border-0 bg-transparent py-1 text-sm text-slate-700 outline-none placeholder:text-slate-400 focus:ring-0"
                                    ></textarea>

                                    <button
                                        type="button"
                                        class="ml-2 flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-blue-600 transition hover:bg-blue-100"
                                        title="Add emoji"
                                    >
                                        <i data-lucide="smile" class="h-5 w-5"></i>
                                    </button>
                                </div>

                                <button
                                    type="submit"
                                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blue-600 text-white shadow-sm transition hover:bg-blue-700 active:scale-95"
                                    title="Send message"
                                >
                                    <i data-lucide="send" class="h-4 w-4"></i>
                                </button>
                            </form>
                        </div>
                    </section>

                    <aside
                        id="teacherDetailsPanel"
                        class="hidden w-[270px] shrink-0 border-l border-slate-200 bg-white xl:flex xl:flex-col"
                    >
                        <div class="flex flex-col items-center border-b border-slate-100 px-5 py-8 text-center">
                            <div
                                id="detailsTeacherAvatar"
                                class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-blue-100 text-2xl font-bold text-blue-700"
                            >
                                JD
                            </div>

                            <h3
                                id="detailsTeacherName"
                                class="text-base font-bold text-slate-900"
                            >
                                Juan Dela Cruz
                            </h3>

                            <p
                                id="detailsTeacherRole"
                                class="mt-1 text-xs text-slate-400"
                            >
                                Faculty Member
                            </p>

                            <div class="mt-2 flex items-center gap-1.5">
                                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                                <span class="text-[11px] font-medium text-emerald-500">
                                    Active now
                                </span>
                            </div>

                            <div class="mt-6 flex items-center gap-3">
                                <button
                                    type="button"
                                    class="flex flex-col items-center gap-1 text-slate-500"
                                >
                                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100">
                                        <i data-lucide="user-round" class="h-4 w-4"></i>
                                    </span>
                                    <span class="text-[10px]">Profile</span>
                                </button>

                                <button
                                    type="button"
                                    class="flex flex-col items-center gap-1 text-slate-500"
                                >
                                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100">
                                        <i data-lucide="bell-off" class="h-4 w-4"></i>
                                    </span>
                                    <span class="text-[10px]">Mute</span>
                                </button>

                                <button
                                    type="button"
                                    class="flex flex-col items-center gap-1 text-slate-500"
                                >
                                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100">
                                        <i data-lucide="search" class="h-4 w-4"></i>
                                    </span>
                                    <span class="text-[10px]">Search</span>
                                </button>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </main>
    </div>

    <div
        id="teacherInfoModal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4 backdrop-blur-sm"
    >
        <div class="w-full max-w-md rounded-2xl bg-white shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
                <h2 class="text-base font-bold text-slate-900">
                    Teacher Information
                </h2>

                <button
                    id="closeTeacherInfo"
                    type="button"
                    class="flex h-8 w-8 items-center justify-center rounded-full text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                >
                    <i data-lucide="x" class="h-5 w-5"></i>
                </button>
            </div>

            <div class="flex flex-col items-center px-5 py-7 text-center">
                <div
                    id="modalTeacherAvatar"
                    class="mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-blue-100 text-xl font-bold text-blue-700"
                >
                    JD
                </div>

                <h3
                    id="modalTeacherName"
                    class="text-lg font-bold text-slate-900"
                >
                    Juan Dela Cruz
                </h3>

                <p
                    id="modalTeacherRole"
                    class="mt-1 text-sm text-slate-400"
                >
                    Faculty Member
                </p>

                <div class="mt-6 w-full space-y-3 text-left">
                    <div class="rounded-xl bg-slate-50 px-4 py-3">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                            Faculty ID
                        </p>
                        <p
                            id="modalFacultyId"
                            class="mt-1 text-sm font-semibold text-slate-700"
                        >
                            FAC-001
                        </p>
                    </div>

                    <div class="rounded-xl bg-slate-50 px-4 py-3">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                            Department
                        </p>
                        <p
                            id="modalDepartment"
                            class="mt-1 text-sm font-semibold text-slate-700"
                        >
                            Information Technology
                        </p>
                    </div>
                </div>
            </div>

            <div class="border-t border-slate-100 px-5 py-4">
                <button
                    id="closeTeacherInfoBtn"
                    type="button"
                    class="w-full rounded-xl bg-blue-600 py-3 text-sm font-semibold text-white transition hover:bg-blue-700"
                >
                    Close
                </button>
            </div>
        </div>
    </div>

    <script src="/js/chat.js"></script>
</body>
</html>
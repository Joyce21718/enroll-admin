<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { pageTitle: 'Chat' }) %>
</head>

<body class="h-screen overflow-hidden bg-slate-50 text-slate-900 antialiased">

<div class="flex h-screen w-full overflow-hidden">

    <%- include('../partials/sidebar', { activePage: 'chat' }) %>

    <main class="flex h-screen min-w-0 flex-1 flex-col overflow-hidden">

        <%- include('../partials/navbar', { pageTitle: 'Chat' }) %>

        <main class="flex-1 overflow-y-auto p-5 sm:p-8">

            <div class="mx-auto flex h-full flex-col">

                <div class="mb-6">
                    <h2 class="text-2xl font-bold text-slate-900">
                        Chat
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Communicate with teachers and faculty members regarding school-related concerns.
                    </p>
                </div>

                <div class="grid min-h-0 flex-1 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm lg:grid-cols-[340px_minmax(0,1fr)]">

                    <aside class="flex min-h-0 flex-col border-b border-slate-200 lg:border-b-0 lg:border-r">

                        <div class="border-b border-slate-200 p-5">

                            <div class="flex items-center justify-between">

                                <div>
                                    <h3 class="font-bold text-slate-900">
                                        Faculty Conversations
                                    </h3>

                                    <p class="mt-1 text-xs text-slate-500">
                                        Messages from teachers
                                    </p>
                                </div>

                                <span
                                    id="conversationCount"
                                    class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-600"
                                >
                                    4
                                </span>

                            </div>

                            <div class="relative mt-4">

                                <i
                                    data-lucide="search"
                                    class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                                ></i>

                                <input
                                    id="chatSearch"
                                    type="text"
                                    placeholder="Search teacher..."
                                    class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 pl-9 pr-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                                >

                            </div>

                        </div>

                        <div
                            id="conversationList"
                            class="flex-1 overflow-y-auto"
                        >

                            <button
                                type="button"
                                data-teacher-id="teacher-1"
                                class="conversation-item flex w-full items-center gap-3 border-b border-slate-100 bg-indigo-50 px-5 py-4 text-left transition hover:bg-indigo-50"
                            >

                                <div class="relative shrink-0">

                                    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-indigo-600 font-bold text-white">
                                        J
                                    </div>

                                    <span class="absolute bottom-0 right-0 h-3 w-3 rounded-full border-2 border-white bg-emerald-500"></span>

                                </div>

                                <div class="min-w-0 flex-1">

                                    <div class="flex items-center justify-between gap-2">

                                        <p class="truncate text-sm font-semibold text-slate-900">
                                            Juan Dela Cruz
                                        </p>

                                        <span class="text-[10px] text-slate-400">
                                            10:42 AM
                                        </span>

                                    </div>

                                    <p class="mt-1 truncate text-xs text-slate-500">
                                        Good morning, Admin. I have a question about my section.
                                    </p>

                                </div>

                                <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-indigo-600 px-1.5 text-[10px] font-bold text-white">
                                    2
                                </span>

                            </button>

                            <button
                                type="button"
                                data-teacher-id="teacher-2"
                                class="conversation-item flex w-full items-center gap-3 border-b border-slate-100 px-5 py-4 text-left transition hover:bg-slate-50"
                            >

                                <div class="relative shrink-0">

                                    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-violet-600 font-bold text-white">
                                        M
                                    </div>

                                </div>

                                <div class="min-w-0 flex-1">

                                    <div class="flex items-center justify-between gap-2">

                                        <p class="truncate text-sm font-semibold text-slate-900">
                                            Maria Santos
                                        </p>

                                        <span class="text-[10px] text-slate-400">
                                            9:18 AM
                                        </span>

                                    </div>

                                    <p class="mt-1 truncate text-xs text-slate-500">
                                        Is there anything else needed for the report?
                                    </p>

                                </div>

                            </button>

                            <button
                                type="button"
                                data-teacher-id="teacher-3"
                                class="conversation-item flex w-full items-center gap-3 border-b border-slate-100 px-5 py-4 text-left transition hover:bg-slate-50"
                            >

                                <div class="relative shrink-0">

                                    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-amber-500 font-bold text-white">
                                        M
                                    </div>

                                </div>

                                <div class="min-w-0 flex-1">

                                    <div class="flex items-center justify-between gap-2">

                                        <p class="truncate text-sm font-semibold text-slate-900">
                                            Mark Reyes
                                        </p>

                                        <span class="text-[10px] text-slate-400">
                                            Yesterday
                                        </span>

                                    </div>

                                    <p class="mt-1 truncate text-xs text-slate-500">
                                        The class list has already been updated.
                                    </p>

                                </div>

                            </button>

                            <button
                                type="button"
                                data-teacher-id="teacher-4"
                                class="conversation-item flex w-full items-center gap-3 border-b border-slate-100 px-5 py-4 text-left transition hover:bg-slate-50"
                            >

                                <div class="relative shrink-0">

                                    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-emerald-600 font-bold text-white">
                                        A
                                    </div>

                                </div>

                                <div class="min-w-0 flex-1">

                                    <div class="flex items-center justify-between gap-2">

                                        <p class="truncate text-sm font-semibold text-slate-900">
                                            Ana Mendoza
                                        </p>

                                        <span class="text-[10px] text-slate-400">
                                            Sep 8
                                        </span>

                                    </div>

                                    <p class="mt-1 truncate text-xs text-slate-500">
                                        Can you check my assigned section?
                                    </p>

                                </div>

                            </button>

                        </div>

                    </aside>

                    <section class="flex min-h-0 flex-1 flex-col">

                        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4 sm:px-6">

                            <div class="flex items-center gap-3">

                                <div class="relative">

                                    <div
                                        id="teacherAvatar"
                                        class="flex h-11 w-11 items-center justify-center rounded-full bg-indigo-600 font-bold text-white"
                                    >
                                        J
                                    </div>

                                    <span
                                        id="teacherOnlineDot"
                                        class="absolute bottom-0 right-0 h-3 w-3 rounded-full border-2 border-white bg-emerald-500"
                                    ></span>

                                </div>

                                <div>

                                    <h3
                                        id="chatUserName"
                                        class="font-bold text-slate-900"
                                    >
                                        Juan Dela Cruz
                                    </h3>

                                    <p
                                        id="chatUserRole"
                                        class="text-xs text-slate-500"
                                    >
                                        Grade 1 Adviser
                                    </p>

                                    <p
                                        id="chatUserStatus"
                                        class="text-xs text-emerald-600"
                                    >
                                        Online
                                    </p>

                                </div>

                            </div>

                            <button
                                id="chatInfoBtn"
                                type="button"
                                title="Teacher Information"
                                class="rounded-xl p-2.5 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
                            >
                                <i data-lucide="info" class="h-5 w-5"></i>
                            </button>

                        </div>

                        <div
                            id="messageContainer"
                            class="flex-1 space-y-5 overflow-y-auto bg-slate-50 p-5 sm:p-6"
                        >

                            <div class="flex justify-start">

                                <div class="max-w-[80%] sm:max-w-[65%]">

                                    <div class="rounded-2xl rounded-bl-md border border-slate-200 bg-white px-4 py-3 shadow-sm">

                                        <p class="text-sm leading-6 text-slate-700">
                                            Good morning, Admin. I have a question about my assigned section.
                                        </p>

                                    </div>

                                    <p class="mt-1 px-1 text-[10px] text-slate-400">
                                        10:35 AM
                                    </p>

                                </div>

                            </div>

                            <div class="flex justify-end">

                                <div class="max-w-[80%] sm:max-w-[65%]">

                                    <div class="rounded-2xl rounded-br-md bg-indigo-600 px-4 py-3 text-white shadow-sm">

                                        <p class="text-sm leading-6">
                                            Good morning, Sir Juan. How can I help you with your section?
                                        </p>

                                    </div>

                                    <p class="mt-1 px-1 text-right text-[10px] text-slate-400">
                                        10:38 AM
                                    </p>

                                </div>

                            </div>

                            <div class="flex justify-start">

                                <div class="max-w-[80%] sm:max-w-[65%]">

                                    <div class="rounded-2xl rounded-bl-md border border-slate-200 bg-white px-4 py-3 shadow-sm">

                                        <p class="text-sm leading-6 text-slate-700">
                                            I would like to request an update regarding the student list.
                                        </p>

                                    </div>

                                    <p class="mt-1 px-1 text-[10px] text-slate-400">
                                        10:41 AM
                                    </p>

                                </div>

                            </div>

                            <div class="flex justify-end">

                                <div class="max-w-[80%] sm:max-w-[65%]">

                                    <div class="rounded-2xl rounded-br-md bg-indigo-600 px-4 py-3 text-white shadow-sm">

                                        <p class="text-sm leading-6">
                                            Sure. I will check the latest student records and update you.
                                        </p>

                                    </div>

                                    <p class="mt-1 px-1 text-right text-[10px] text-slate-400">
                                        10:42 AM
                                    </p>

                                </div>

                            </div>

                        </div>

                        <div class="border-t border-slate-200 bg-white p-4 sm:p-5">

                            <form
                                id="messageForm"
                                class="flex items-end gap-3"
                            >

                                <div class="flex-1">

                                    <textarea
                                        id="messageInput"
                                        rows="1"
                                        placeholder="Type a message to this teacher..."
                                        class="max-h-32 min-h-[46px] w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
                                    ></textarea>

                                </div>

                                <button
                                    type="submit"
                                    title="Send Message"
                                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-sm transition hover:bg-indigo-700"
                                >
                                    <i data-lucide="send" class="h-5 w-5"></i>
                                </button>

                            </form>

                            <p class="mt-2 text-[10px] text-slate-400">
                                Use this chat for school and enrollment-related communication.
                            </p>

                        </div>

                    </section>

                </div>

                <footer class="py-5 text-center text-xs text-slate-400">
                    © 2026 Elementary Enrollment Management System. All rights reserved.
                </footer>

            </div>

        </main>

    </main>

</div>

<div
    id="teacherInfoModal"
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-950/50 p-4 backdrop-blur-sm"
>

    <div class="w-full max-w-md rounded-2xl bg-white shadow-2xl">

        <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">

            <div>
                <h3 class="text-lg font-bold text-slate-900">
                    Teacher Information
                </h3>

                <p class="mt-1 text-xs text-slate-500">
                    Faculty member details
                </p>
            </div>

            <button
                id="closeTeacherInfo"
                type="button"
                class="rounded-xl p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
            >
                <i data-lucide="x" class="h-5 w-5"></i>
            </button>

        </div>

        <div class="space-y-4 p-6">

            <div class="flex items-center gap-4 rounded-xl bg-slate-50 p-4">

                <div
                    id="modalTeacherAvatar"
                    class="flex h-12 w-12 items-center justify-center rounded-full bg-indigo-600 font-bold text-white"
                >
                    J
                </div>

                <div>
                    <p
                        id="modalTeacherName"
                        class="font-bold text-slate-900"
                    >
                        Juan Dela Cruz
                    </p>

                    <p
                        id="modalTeacherRole"
                        class="text-xs text-slate-500"
                    >
                        Grade 1 Adviser
                    </p>
                </div>

            </div>

            <div class="grid gap-3 sm:grid-cols-2">

                <div class="rounded-xl border border-slate-200 p-4">
                    <p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">
                        Faculty ID
                    </p>

                    <p
                        id="modalFacultyId"
                        class="mt-1 text-sm font-semibold text-slate-800"
                    >
                        FAC-001
                    </p>
                </div>

                <div class="rounded-xl border border-slate-200 p-4">
                    <p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">
                        Department
                    </p>

                    <p
                        id="modalDepartment"
                        class="mt-1 text-sm font-semibold text-slate-800"
                    >
                        Elementary
                    </p>
                </div>

            </div>

        </div>

        <div class="border-t border-slate-200 px-6 py-4">

            <button
                id="closeTeacherInfoBtn"
                type="button"
                class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
            >
                Close
            </button>

        </div>

    </div>

</div>

<script src="/js/chat.js" defer></script>

</body>
</html>
<%- include('../partials/head', { pageTitle: 'Enrollment' }) %>

<body class="h-screen overflow-hidden bg-slate-50 text-slate-900">

<div class="flex h-screen w-full overflow-hidden">

  <%- include('../partials/sidebar', { activePage: 'enrollment' }) %>

  <main class="flex h-screen min-w-0 flex-1 flex-col overflow-hidden">

    <%- include('../partials/navbar', {
        pageTitle: 'Enrollment'
    }) %>

    <div class="scrollbar-hidden flex-1 overflow-y-auto overflow-x-hidden">

      <div class="mx-auto p-5 sm:p-8">

        <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

          <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">
              Enrollment Applications
            </h1>

            <p class="mt-1 text-sm text-slate-500">
              Review, approve, or decline student applications.
            </p>
          </div>

          <button
            id="addApplicationBtn"
            type="button"
            class="flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-200 transition hover:bg-indigo-700"
          >
            <i data-lucide="plus" class="h-5 w-5"></i>
            New Enrollment
          </button>

        </div>

        <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-slate-500">
                  Total Applications
                </p>
                <p id="totalApplications" class="mt-2 text-3xl font-extrabold text-slate-900">
                  124
                </p>
                <p class="mt-1 text-xs text-slate-500">
                  This school year
                </p>
              </div>

              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                <i data-lucide="files" class="h-5 w-5"></i>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-slate-500">
                  Pending
                </p>
                <p id="pendingApplications" class="mt-2 text-3xl font-extrabold text-slate-900">
                  12
                </p>
                <p class="mt-1 text-xs text-amber-600">
                  Needs review
                </p>
              </div>

              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                <i data-lucide="clock-3" class="h-5 w-5"></i>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-slate-500">
                  Approved
                </p>
                <p id="approvedApplications" class="mt-2 text-3xl font-extrabold text-slate-900">
                  98
                </p>
                <p class="mt-1 text-xs text-emerald-600">
                  Successfully enrolled
                </p>
              </div>

              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                <i data-lucide="badge-check" class="h-5 w-5"></i>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-slate-500">
                  Declined
                </p>
                <p id="declinedApplications" class="mt-2 text-3xl font-extrabold text-slate-900">
                  14
                </p>
                <p class="mt-1 text-xs text-red-600">
                  Applications declined
                </p>
              </div>

              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-red-50 text-red-600">
                <i data-lucide="badge-x" class="h-5 w-5"></i>
              </div>
            </div>
          </div>

        </div>

        <div class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

          <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

            <div class="relative w-full lg:max-w-md">

              <i
                data-lucide="search"
                class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
              ></i>

              <input
                id="searchInput"
                type="text"
                placeholder="Search student or parent..."
                class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
              >

            </div>

            <div class="flex flex-wrap gap-3">

              <select
                id="gradeFilter"
                class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500"

        Decline
      </button>

      <button
        id="modalApproveBtn"
        type="button"
        class="hidden rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-700"
      >
        Approve
      </button>

      <button
        id="modalCloseBtn"
        type="button"
        class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50"
      >
        Close
      </button>

    </div>

  </div>

</div>

<div
  id="addApplicationModal"
  class="fixed inset-0 z-[110] hidden items-center justify-center bg-slate-950/50 p-4 backdrop-blur-sm"
>

  <div class="w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl">

    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">

      <div>
        <h2 class="text-lg font-bold text-slate-900">
          New Enrollment
        </h2>

        <p class="mt-1 text-xs text-slate-500">
          Enter the student's enrollment information
        </p>
      </div>

      <button
        id="closeAddApplicationModalBtn"
        type="button"
        class="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
      >
        <i data-lucide="x" class="h-5 w-5"></i>
      </button>

    </div>

    <form id="addApplicationForm">

      <div class="max-h-[70vh] overflow-y-auto p-6">

        <div class="grid gap-4 sm:grid-cols-2">

          <div class="sm:col-span-2">

            <label class="mb-2 block text-xs font-bold text-slate-600">
              Student Name
            </label>

            <input
              id="newStudentName"
              type="text"
              required
              placeholder="Enter student name"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
            >

          </div>

          <div>

            <label class="mb-2 block text-xs font-bold text-slate-600">
              Student ID
            </label>

            <input
              id="newStudentId"
              type="text"
              required
              placeholder="2026-006"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
            >

          </div>

          <div>

            <label class="mb-2 block text-xs font-bold text-slate-600">
              Parent / Guardian
            </label>

            <input
              id="newParent"
              type="text"
              required
              placeholder="Enter parent or guardian"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
            >

          </div>

          <div>

            <label class="mb-2 block text-xs font-bold text-slate-600">
              Grade Level
            </label>

            <select
              id="newGrade"
              required
              class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500"
            >
              <option value="">Select grade</option>
              <option value="Kindergarten">Kindergarten</option>
              <option value="Grade 1">Grade 1</option>
              <option value="Grade 2">Grade 2</option>
              <option value="Grade 3">Grade 3</option>
              <option value="Grade 4">Grade 4</option>
              <option value="Grade 5">Grade 5</option>
              <option value="Grade 6">Grade 6</option>
            </select>

          </div>

          <div>

            <label class="mb-2 block text-xs font-bold text-slate-600">
              Gender
            </label>

            <select
              id="newGender"
              required
              class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500"
            >
              <option value="">Select gender</option>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
            </select>

          </div>

          <div>

            <label class="mb-2 block text-xs font-bold text-slate-600">
              Section
            </label>

            <input
              id="newSection"
              type="text"
              required
              placeholder="Example: Mabini"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
            >

          </div>

          <div>

            <label class="mb-2 block text-xs font-bold text-slate-600">
              Address
            </label>

            <input
              id="newAddress"
              type="text"
              required
              placeholder="Enter address"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100"
            >

          </div>

        </div>

      </div>

      <div class="flex justify-end gap-3 border-t border-slate-200 px-6 py-4">

        <button
          id="cancelAddApplicationBtn"
          type="button"
          class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50"
        >
          Cancel
        </button>

        <button
          type="submit"
          class="rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-indigo-700"
        >
          Save Application
        </button>

      </div>

    </form>

  </div>

</div>

<script src="/js/enrollment.js" defer></script>

</body>
</html>
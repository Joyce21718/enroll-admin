<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Elementary Enrollment</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
    >
</head>

<body class="flex min-h-screen items-center justify-center bg-gradient-to-br from-slate-100 via-slate-200 to-indigo-100 p-4 text-slate-900 sm:p-6 lg:p-8">

    <div class="flex w-full max-w-5xl overflow-hidden rounded-[2.5rem] border border-slate-100 bg-white shadow-2xl shadow-slate-950/30 lg:flex-row">

        <div class="relative hidden overflow-hidden bg-slate-950 text-white lg:flex lg:w-1/2 lg:flex-col lg:justify-between">

            <div class="absolute inset-0 bg-cover bg-center opacity-40 mix-blend-overlay transition-transform duration-[2000ms] hover:scale-110"
                style="background-image: url('https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=1200&auto=format&fit=crop');">
            </div>

            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-indigo-950/60 to-slate-900/40"></div>

            <div class="relative z-10 flex items-center gap-3.5 p-12">

                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-violet-500 text-xl font-black text-white shadow-lg shadow-indigo-500/30 ring-1 ring-white/20">
                    E
                </div>

                <div>
                    <h1 class="text-base font-bold tracking-tight text-white">
                        Elementary Enrollment
                    </h1>

                    <p class="text-xs font-medium text-indigo-300">
                        Management System
                    </p>
                </div>

            </div>

            <div class="relative z-10 my-auto px-12 py-12">

                <span class="inline-flex items-center gap-2 rounded-full bg-indigo-500/10 px-4 py-1.5 text-xs font-semibold text-indigo-300 ring-1 ring-indigo-500/30 backdrop-blur-md">

                    <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>

                    Administration Portal v2.0

                </span>

                <h2 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-white">
                    Manage records with precision and ease.
                </h2>

                <p class="mt-4 text-sm leading-relaxed text-slate-300">
                    Securely access student applications, faculty rosters, sections,
                    and automated reports from a single centralized dashboard.
                </p>

            </div>

            <div class="relative z-10 flex items-center justify-between px-12 pb-8 text-xs text-slate-400">

                <span>
                    © 2026 Elementary Enrollment System
                </span>

                <div class="flex items-center gap-1.5 text-indigo-300">

                    <i data-lucide="shield-check" class="h-4 w-4"></i>

                    <span>
                        Secure Connection
                    </span>

                </div>

            </div>

        </div>

        <div class="flex w-full items-center justify-center bg-white p-8 sm:p-12 lg:w-1/2 lg:p-16">

            <div class="w-full max-w-md">

                <div class="mb-8 flex items-center gap-3 lg:hidden">

                    <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-500 text-lg font-black text-white shadow-md">
                        E
                    </div>

                    <div>
                        <h1 class="text-sm font-bold text-slate-900">
                            Elementary Enrollment
                        </h1>

                        <p class="text-xs font-medium text-indigo-600">
                            Management System
                        </p>
                    </div>

                </div>

                <div class="mb-8">

                    <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 ring-1 ring-indigo-100">

                        <i data-lucide="lock" class="h-6 w-6"></i>

                    </div>

                    <h2 class="text-2xl font-bold tracking-tight text-slate-900">
                        Welcome Back
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Please enter your administrator credentials to continue.
                    </p>

                </div>

                <form id="loginForm" class="space-y-5">

                    <div>

                        <label
                            for="username"
                            class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-600"
                        >
                            Username
                        </label>

                        <div class="group relative">

                            <i
                                data-lucide="user"
                                class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400 transition-colors group-focus-within:text-indigo-600"
                            ></i>

                            <input
                                id="username"
                                name="username"
                                type="text"
                                autocomplete="username"
                                placeholder="Enter your username"
                                required
                                class="w-full rounded-2xl border border-slate-200 bg-slate-50/50 py-3.5 pl-12 pr-4 text-sm text-slate-900 outline-none transition-all duration-200 placeholder:text-slate-400 focus:border-indigo-600 focus:bg-white focus:ring-4 focus:ring-indigo-600/10"
                            >

                        </div>

                    </div>

                    <div>

                        <div class="mb-2 flex items-center justify-between">

                            <label
                                for="password"
                                class="block text-xs font-bold uppercase tracking-wider text-slate-600"
                            >
                                Password
                            </label>

                            <button
                                id="forgotPasswordBtn"
                                type="button"
                                class="text-xs font-semibold text-indigo-600 transition hover:text-indigo-700"
                            >
                                Forgot password?
                            </button>

                        </div>

                        <div class="group relative">

                            <i
                                data-lucide="key-round"
                                class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400 transition-colors group-focus-within:text-indigo-600"
                            ></i>

                            <input
                                id="password"
                                name="password"
                                type="password"
                                autocomplete="current-password"
                                placeholder="Enter your password"
                                required
                                class="w-full rounded-2xl border border-slate-200 bg-slate-50/50 py-3.5 pl-12 pr-12 text-sm text-slate-900 outline-none transition-all duration-200 placeholder:text-slate-400 focus:border-indigo-600 focus:bg-white focus:ring-4 focus:ring-indigo-600/10"
                            >

                            <button
                                id="togglePasswordBtn"
                                type="button"
                                title="Show password"
                                class="absolute right-3.5 top-1/2 -translate-y-1/2 rounded-xl p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
                            >

                                <i
                                    id="passwordIcon"
                                    data-lucide="eye"
                                    class="h-4 w-4"
                                ></i>

                            </button>

                        </div>

                    </div>

                    <div
                        id="loginMessage"
                        class="hidden rounded-2xl border px-4 py-3 text-sm"
                    ></div>

                    <button
                        id="loginBtn"
                        type="submit"
                        class="flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-4 text-sm font-bold text-white shadow-lg shadow-indigo-600/25 transition-all hover:from-indigo-500 hover:to-violet-500 hover:shadow-indigo-600/40 focus:outline-none focus:ring-4 focus:ring-indigo-600/20 active:scale-[0.99]"
                    >

                        <i data-lucide="log-in" class="h-5 w-5"></i>

                        <span id="loginBtnText">
                            Sign In to Dashboard
                        </span>

                    </button>

                </form>

                <div class="mt-8 flex items-center gap-3">

                    <div class="h-px flex-1 bg-slate-100"></div>

                    <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">
                        Secure Gateway
                    </span>

                    <div class="h-px flex-1 bg-slate-100"></div>

                </div>

                <div class="mt-6 flex items-center justify-center gap-2 text-xs text-slate-500">

                    <i data-lucide="shield" class="h-4 w-4 text-indigo-600"></i>

                    <span>
                        Authorized administrative access only
                    </span>

                </div>

            </div>

        </div>

    </div>

    <div
        id="forgotPasswordModal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-md"
    >

        <div class="w-full max-w-md overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-2xl">

            <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">

                <div>

                    <h3 class="text-lg font-bold text-slate-900">
                        Password Recovery
                    </h3>

                    <p class="mt-0.5 text-xs text-slate-500">
                        Assistance for your account credentials.
                    </p>

                </div>

                <button
                    id="closeForgotPasswordBtn"
                    type="button"
                    class="rounded-xl p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                >

                    <i data-lucide="x" class="h-5 w-5"></i>

                </button>

            </div>

            <div class="p-6">

                <div class="rounded-2xl border border-indigo-100 bg-indigo-50/70 p-4">

                    <div class="flex gap-3">

                        <i
                            data-lucide="info"
                            class="mt-0.5 h-5 w-5 shrink-0 text-indigo-600"
                        ></i>

                        <p class="text-sm leading-relaxed text-indigo-950">
                            If you forgot your administrator password, please contact
                            the primary system administrator to securely reset your account credentials.
                        </p>

                    </div>

                </div>

            </div>

            <div class="border-t border-slate-100 bg-slate-50/50 px-6 py-4">

                <button
                    id="closeForgotPasswordBtnBottom"
                    type="button"
                    class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100"
                >
                    Close
                </button>

            </div>

        </div>

    </div>

    <script src="/js/login.js" defer></script>

</body>
</html>
          <div>
            <h1 class="text-2xl font-bold text-slate-900">
              Faculty Records
            </h1>

            <p class="mt-1 text-sm text-slate-500">
              Manage and monitor registered faculty members.
            </p>
          </div>

          <button id="addFacultyBtn"

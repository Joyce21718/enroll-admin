                                <p
                                    id="modalEmail"
                                    class="mt-1 text-sm font-semibold text-slate-700"
                                >
                                    juan.delacruz@email.com
                                </p>
                            </div>

                        </div>

                    </div>


                    <!-- Contact -->
                    <div class="rounded-xl border border-slate-200 p-4">

                        <div class="flex items-center gap-3">

                            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                                <i data-lucide="phone" class="h-4 w-4"></i>
                            </div>

                            <div>
                                <p class="text-xs font-medium text-slate-400">
                                    Contact
                                </p>

                                <p
                                    id="modalContact"
                                    class="mt-1 text-sm font-semibold text-slate-700"
                                >
                                    0917-123-4567
                                </p>
                            </div>

                        </div>

                    </div>


                    <!-- Department -->
                    <div class="rounded-xl border border-slate-200 p-4">

                        <div class="flex items-center gap-3">

                            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-violet-50 text-violet-600">
                                <i data-lucide="building-2" class="h-4 w-4"></i>
                            </div>

                            <div>
                                <p class="text-xs font-medium text-slate-400">
                                    Department
                                </p>

                                <p
                                    id="modalDepartment"
                                    class="mt-1 text-sm font-semibold text-slate-700"
                                >
                                    Elementary
                                </p>
                            </div>

                        </div>

                    </div>


                    <!-- Position -->
                    <div class="rounded-xl border border-slate-200 p-4">

                        <div class="flex items-center gap-3">

                            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
                                <i data-lucide="briefcase" class="h-4 w-4"></i>
                            </div>

                            <div>
                                <p class="text-xs font-medium text-slate-400">
                                    Position
                                </p>

                                <p
                                    id="modalPosition"
                                    class="mt-1 text-sm font-semibold text-slate-700"
                                >
                                    Grade 1 Teacher
                                </p>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Status -->
                <div class="mt-4 rounded-xl border border-slate-200 p-4">

                    <div class="flex items-center justify-between">

                        <div class="flex items-center gap-3">

                            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                                <i data-lucide="badge-check" class="h-4 w-4"></i>
                            </div>

                            <div>
                                <p class="text-xs font-medium text-slate-400">
                                    Employment Status
                                </p>

                                <p class="mt-1 text-sm font-semibold text-slate-700">
                                    Current Status
                                </p>
                            </div>

                        </div>

                        <span
                            id="modalStatusBadge"
                            class="inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-600"
                        >
                            Active
                        </span>

                    </div>

                </div>

            </div>


            <!-- Modal Footer -->
            <div class="flex justify-end border-t border-slate-200 bg-slate-50 px-6 py-4">

                <button
                    type="button"
                    id="modalCloseBtn"
                    class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
                >
                    Close
                </button>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- ADD FACULTY MODAL -->
    <!-- ===================================================== -->

    <div
        id="addFacultyModal"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-950/50 p-4 backdrop-blur-sm"
    >

        <div class="w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl">

            <!-- Header -->
            <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">

                <div>
                    <h2 class="text-lg font-bold text-slate-900">
                        Add Faculty
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Add a new faculty member to the system.
                    </p>
                </div>

                <button
                    type="button"
                    id="closeAddFacultyModalBtn"
                    class="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                >
                    <i data-lucide="x" class="h-5 w-5"></i>
                </button>

            </div>


            <!-- Form -->
            <form id="addFacultyForm">

                <div class="grid gap-5 px-6 py-6 sm:grid-cols-2">

                    <!-- Full Name -->
                    <div class="sm:col-span-2">

                        <label
                            for="facultyName"
                            class="mb-2 block text-sm font-semibold text-slate-700"
                        >
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="facultyName"
                            name="name"
                            placeholder="Enter full name"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                            required
                        >

                    </div>


                    <!-- Faculty ID -->
                    <div>

                        <label
                            for="facultyId"
                            class="mb-2 block text-sm font-semibold text-slate-700"
                        >
                            Faculty ID
                        </label>

                        <input
                            type="text"
                            id="facultyId"
                            name="facultyId"
                            placeholder="FAC-2026-001"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                            required
                        >

                    </div>


                    <!-- Email -->
                    <div>

                        <label
                            for="facultyEmail"
                            class="mb-2 block text-sm font-semibold text-slate-700"
                        >
                            Email
                        </label>

                        <input
                            type="email"
                            id="facultyEmail"
                            name="email"
                            placeholder="faculty@email.com"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                            required
                        >

                    </div>


                    <!-- Department -->
                    <div>

                        <label
                            for="facultyDepartment"
                            class="mb-2 block text-sm font-semibold text-slate-700"
                        >
                            Department
                        </label>

                        <select
                            id="facultyDepartment"
                            name="department"
                            class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                            required
                        >
                            <option value="">
                                Select department
                            </option>

                            <option value="Elementary">
                                Elementary
                            </option>

                            <option value="Kindergarten">
                                Kindergarten
                            </option>

                            <option value="Administration">
                                Administration
                            </option>
                        </select>

                    </div>


                    <!-- Position -->
                    <div>

                        <label
                            for="facultyPosition"
                            class="mb-2 block text-sm font-semibold text-slate-700"
                        >
                            Position
                        </label>

                        <input
                            type="text"
                            id="facultyPosition"
                            name="position"
                            placeholder="e.g. Grade 1 Teacher"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                            required
                        >

                    </div>


                    <!-- Contact -->
                    <div>

                        <label
                            for="facultyContact"
                            class="mb-2 block text-sm font-semibold text-slate-700"
                        >
                            Contact Number
                        </label>

                        <input
                            type="text"
                            id="facultyContact"
                            name="contact"
                            placeholder="09XX-XXX-XXXX"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                            required
                        >

                    </div>


                    <!-- Status -->
                    <div>

                        <label
                            for="facultyStatus"
                            class="mb-2 block text-sm font-semibold text-slate-700"
                        >
                            Status
                        </label>

                        <select
                            id="facultyStatus"
                            name="status"
                            class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                        >

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                    </div>

                </div>


                <!-- Footer -->
                <div class="flex justify-end gap-3 border-t border-slate-200 bg-slate-50 px-6 py-4">

                    <button
                        type="button"
                        id="cancelAddFacultyBtn"
                        class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-600 transition hover:bg-slate-100"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
                    >
                        Save Faculty
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- Faculty JS -->
    <script src="/js/faculty.js" defer></script>

</body>
</html>
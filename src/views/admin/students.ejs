                <p
                  id="modalSection"
                  class="mt-1 text-sm font-semibold text-slate-700"
                >
                  Mabini
                </p>

              </div>

            </div>

          </div>


          <!-- GUARDIAN -->
          <div class="rounded-xl border border-slate-200 p-4">

            <div class="flex items-center gap-3">

              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                <i data-lucide="users" class="h-4 w-4"></i>
              </div>

              <div>

                <p class="text-xs font-medium text-slate-400">
                  Parent / Guardian
                </p>

                <p
                  id="modalGuardian"
                  class="mt-1 text-sm font-semibold text-slate-700"
                >
                  Maria Dela Cruz
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- STATUS -->
        <div class="mt-4 rounded-xl border border-slate-200 p-4">

          <div class="flex items-center justify-between">

            <div class="flex items-center gap-3">

              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                <i data-lucide="badge-check" class="h-4 w-4"></i>
              </div>

              <div>

                <p class="text-xs font-medium text-slate-400">
                  Enrollment Status
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-700">
                  Current Status
                </p>

              </div>

            </div>

            <span
              id="modalStatusBadge"
              class="inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-600"
            >
              Active
            </span>

          </div>

        </div>

      </div>


      <!-- FOOTER -->
      <div class="flex justify-end border-t border-slate-200 bg-slate-50 px-6 py-4">

        <button
          type="button"
          id="modalCloseBtn"
          class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
        >
          Close
        </button>

      </div>

    </div>

  </div>


  <!-- =====================================================
       ADD STUDENT MODAL
  ====================================================== -->

  <div
    id="addStudentModal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-950/50 p-4 backdrop-blur-sm"
  >

    <div class="w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl">

      <!-- HEADER -->
      <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">

        <div>
          <h2 class="text-lg font-bold text-slate-900">
            Add Student
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Add a new student to the system.
          </p>
        </div>

        <button
          type="button"
          id="closeAddStudentModalBtn"
          class="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
        >
          <i data-lucide="x" class="h-5 w-5"></i>
        </button>

      </div>


      <!-- FORM -->
      <form id="addStudentForm">

        <div class="grid gap-5 px-6 py-6 sm:grid-cols-2">

          <!-- FULL NAME -->
          <div class="sm:col-span-2">

            <label
              for="studentName"
              class="mb-2 block text-sm font-semibold text-slate-700"
            >
              Full Name
            </label>

            <input
              type="text"
              id="studentName"
              name="name"
              placeholder="Enter student full name"
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              required
            >

          </div>


          <!-- STUDENT ID -->
          <div>

            <label
              for="studentId"
              class="mb-2 block text-sm font-semibold text-slate-700"
            >
              Student ID
            </label>

            <input
              type="text"
              id="studentId"
              name="studentId"
              placeholder="STU-2026-001"
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              required
            >

          </div>


          <!-- GENDER -->
          <div>

            <label
              for="studentGender"
              class="mb-2 block text-sm font-semibold text-slate-700"
            >
              Gender
            </label>

            <select
              id="studentGender"
              name="gender"
              class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              required
            >

              <option value="">
                Select gender
              </option>

              <option value="Male">
                Male
              </option>

              <option value="Female">
                Female
              </option>

            </select>

          </div>


          <!-- GRADE -->
          <div>

            <label
              for="studentGrade"
              class="mb-2 block text-sm font-semibold text-slate-700"
            >
              Grade Level
            </label>

            <select
              id="studentGrade"
              name="grade"
              class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              required
            >

              <option value="">
                Select grade
              </option>

              <option value="Kindergarten">
                Kindergarten
              </option>

              <option value="Grade 1">
                Grade 1
              </option>

              <option value="Grade 2">
                Grade 2
              </option>

              <option value="Grade 3">
                Grade 3
              </option>

              <option value="Grade 4">
                Grade 4
              </option>

              <option value="Grade 5">
                Grade 5
              </option>

              <option value="Grade 6">
                Grade 6
              </option>

            </select>

          </div>


          <!-- SECTION -->
          <div>

            <label
              for="studentSection"
              class="mb-2 block text-sm font-semibold text-slate-700"
            >
              Section
            </label>

            <select
              id="studentSection"
              name="section"
              class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              required
            >

              <option value="">
                Select section
              </option>

              <option value="Mabini">
                Mabini
              </option>

              <option value="Rizal">
                Rizal
              </option>

              <option value="Bonifacio">
                Bonifacio
              </option>

              <option value="Sampaguita">
                Sampaguita
              </option>

            </select>

          </div>


          <!-- GUARDIAN -->
          <div>

            <label
              for="studentGuardian"
              class="mb-2 block text-sm font-semibold text-slate-700"
            >
              Parent / Guardian
            </label>

            <input
              type="text"
              id="studentGuardian"
              name="guardian"
              placeholder="Enter parent or guardian"
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              required
            >

          </div>


          <!-- STATUS -->
          <div>

            <label
              for="studentStatus"
              class="mb-2 block text-sm font-semibold text-slate-700"
            >
              Status
            </label>

            <select
              id="studentStatus"
              name="status"
              class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
            >

              <option value="Active">
                Active
              </option>

              <option value="Inactive">
                Inactive
              </option>

            </select>

          </div>

        </div>


        <!-- FOOTER -->
        <div class="flex justify-end gap-3 border-t border-slate-200 bg-slate-50 px-6 py-4">

          <button
            type="button"
            id="cancelAddStudentBtn"
            class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-600 transition hover:bg-slate-100"
          >
            Cancel
          </button>

          <button
            type="submit"
            class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
          >
            Save Student
          </button>

        </div>

      </form>

    </div>

  </div>


  <script src="/js/students.js" defer></script>

</body>
</html>